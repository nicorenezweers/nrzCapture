{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nrzCapture",
  "version": "1.1.0",
  "identifier": "com.nrz.capture",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "15.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMTMyNTIwQzkzNTU3NUYKUldSZlZ6WEpJQ1VUNnhwVEdmdlVXaE55V0NSaXVxdC9tT24wVWVXSU5ZUWZpUm5nMEh4K1dxdjcK",
      "dangerousInsecureTransportProtocol": true,
      "endpoints": [
        "http://100.78.107.162:8390/nicorenezweers/nrzCapture/raw/main/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "nrzcapture"
        ]
      }
    }
  }
}